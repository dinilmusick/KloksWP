{
  "name": "ultrst-armada/klokswp",
  "description": "KloksWP reusable WordPress backend service and state library built on KrnlWP",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "KloksWP\\": "src/"
    }
  },
  "require": {
    "php": ">=8.2",
    "ultrst-armada/krnlwp": "^0.1",
    "symfony/http-client": "^7.3",
    "symfony/workflow": "^7.3"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/dinilmusick/KrnlWP"
    }
  ],
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  }
}
